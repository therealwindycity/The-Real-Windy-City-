    "/search(?:/|$)",
    "/cart(?:/|$)",
    "/checkout(?:/|$)",
    "/myaccount(?:/|$)",
    "/forms?(?:/|$)",
    "/payments?(?:/|$)",
    "\\.(?:js|css|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|mov|avi|zip|exe|msi)$"
  ],
  "document_types": {
    "application/pdf": ".pdf",
    "text/plain": ".txt"
  },
  "max_run_seconds": 5400,
  "max_archive_bytes": 400000000
}
