# Copy to .env (never commit it) or set as GitHub Actions / Streamlit secrets.
# --- alerts (all optional; with none set, alerts go to data/out/alerts.log) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_MIN_SEVERITY=medium
# --- optional LLM red-flag pass (any OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# --- records-request letterhead ---
REQUESTER_NAME=
REQUESTER_CONTACT=
