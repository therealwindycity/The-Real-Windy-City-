+FIXTURES_DIR = Path(__file__).resolve().parent / "fixtures"
+JFK_WAV = FIXTURES_DIR / "jfk_16k.wav"
+EVER_TRIED_WAV = FIXTURES_DIR / "ever_tried_16k.wav"
