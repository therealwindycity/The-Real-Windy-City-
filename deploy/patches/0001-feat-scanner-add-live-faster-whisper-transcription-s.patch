+import { chromium, expect } from "@playwright/test";
+import { spawn } from "node:child_process";
+import { mkdir } from "node:fs/promises";
+import path from "node:path";
+
+await mkdir("test-output", { recursive: true });
+
+let launchOptions = { headless: true, args: ["--no-sandbox"] };
+if (process.env.CHROMIUM_PATH) {
+  let extraArgs = ["--disable-gpu", "--single-process", "--no-zygote"];
+  try {
+    extraArgs = (await import("@sparticuz/chromium")).default.args;
+  } catch {}
+  launchOptions = {
+    headless: true,
+    executablePath: process.env.CHROMIUM_PATH,
+    args: [...new Set([...extraArgs, "--no-sandbox"])],
+  };
+}
+
+const LIVE_URL = (process.env.BASE_URL || "http://127.0.0.1:4173").replace(/\/+$/, "");
+
+// Spin up a second static-only server WITH NO BACKEND UPSTREAM on port 4174 to prove
+// honest degraded/unavailable UI behavior when no persistent backend service exists!
+const staticOnlyServer = spawn(
+  process.execPath,
+  [path.resolve("scripts/serve.mjs"), "out"],
+  {
+    env: { ...process.env, HOST: "127.0.0.1", PORT: "4174", SCANNER_UPSTREAM_URL: "" },
+    stdio: "ignore",
+  },
+);
+
+await new Promise((r) => setTimeout(r, 900));
+
+const browser = await chromium.launch(launchOptions);
+const pageErrors = [];
+
+function stubThirdPartyFeeds(context) {
+  return Promise.all([
+    context.route("https://api.weather.gov/**", (route) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/geo+json",
+        body: JSON.stringify({ features: [], properties: {} }),
+      }),
+    ),
+    context.route("https://www.wyoroad.info/**", (route) =>
+      route.fulfill({
+        status: 200,
+        contentType: "text/html",
+        body: "<html><body>No advisories.</body></html>",
+      }),
+    ),
+    context.route("https://services3.arcgis.com/**", (route) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify({ features: [] }),
+      }),
+    ),
+    context.route("https://earthquake.usgs.gov/**", (route) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/geo+json",
+        body: JSON.stringify({ features: [] }),
+      }),
+    ),
+    context.route("https://api.rss2json.com/**", (route) =>
+      route.fulfill({
+        status: 200,
+        contentType: "application/json",
+        body: JSON.stringify({ status: "ok", items: [] }),
+      }),
+    ),
+  ]);
+}
+
+try {
+  // ─── PART 1: Live end-to-end vertical slice (Audio -> ffmpeg -> faster-whisper -> SQLite -> API -> Browser) ───
+  const liveCtx = await browser.newContext({
+    viewport: { width: 1440, height: 1000 },
+    ignoreHTTPSErrors: true,
+  });
+  await stubThirdPartyFeeds(liveCtx);
+  const page = await liveCtx.newPage();
+  page.on("pageerror", (err) => pageErrors.push(err.message));
+
+  await page.goto(`${LIVE_URL}/hub/signals/`, { waitUntil: "domcontentloaded" });
+
+  // 1. Existing audio controls remain intact and functional
+  await expect(page.locator(".pulse-scanner-tuner")).toContainText(
+    "Laramie County Law Enforcement",
+  );
+  await expect(page.getByRole("button", { name: "Listen live" })).toBeVisible();
+  await expect(page.getByRole("button", { name: "Embed web tuner" })).toBeVisible();
+  await expect(page.getByRole("link", { name: /Broadcastify/ })).toBeVisible();
+  await expect(page.getByRole("link", { name: /Cheyenne CAD Map/ })).toBeVisible();
+
+  // 2. Mandatory verbatim two-line disclaimer is rendered prominently
+  const panel = page.locator(".scanner-transcript-panel");
+  await expect(panel).toBeVisible();
+  await expect(panel).toContainText(
+    "Automatic radio transcription. May contain errors or omissions.",
+  );
+  await expect(panel).toContainText(
+    "Not verified dispatch information and not for emergency response.",
+  );
+
+  // 3. Wait for real faster-whisper transcribed speech segment to arrive from live HTTP audio stream!
+  await expect
+    .poll(
+      async () => {
+        const text = (await panel.textContent()) || "";
+        return (
+          /fellow americans|country can do|ever tried/i.test(text) &&
+          (await page.locator(".scanner-segment-item").count()) >= 1
+        );
+      },
+      { timeout: 25_000, message: "Expected real faster-whisper speech segment in Signals UI" },
+    )
+    .toBe(true);
+
+  await expect(panel).toHaveAttribute("data-scanner-live", "true");
+  await expect(page.getByTestId("scanner-status-pill")).toContainText(/LIVE/);
+  await expect(panel.locator(".scanner-segment-time").first()).toContainText(/MDT|MST/);
+  await expect(panel.locator(".scanner-segment-age").first()).toContainText(/old/);
+  await expect(panel).toContainText(/faster-whisper/i);
+  await expect(panel.locator(".scanner-recency-badge").first()).toContainText("LIVE WINDOW");
+
+  // 4. Verify strict provenance separation on newsroom & municipal items in the feed!
+  const newsroomCards = page.locator('.broadcast-alert[data-source-kind="newsroom_article"]');
+  await expect(newsroomCards.first()).toBeVisible();
+  await expect(newsroomCards.first().getByTestId("alert-source-badge")).toContainText("NEWSROOM ·");
+  await expect(newsroomCards.first()).not.toContainText("SCANNER / CAD");
+
+  const inferredPill = newsroomCards
+    .first()
+    .locator('[data-metadata-origin="inferred_related_feed"]');
+  await expect(inferredPill).toContainText("Related scanner hint:");
+
+  // Clicking "Tune related scanner #47003" on a newsroom article tunes audio WITHOUT turning the article into a radio transcript!
+  const tunableNewsroomCard = newsroomCards
+    .filter({ has: page.locator(".broadcast-tune-button") })
+    .first();
+  await expect(tunableNewsroomCard).toBeVisible();
+  const tuneBtn = tunableNewsroomCard.getByRole("button", { name: /Tune related scanner/ });
+  await tuneBtn.click();
+  await expect(tunableNewsroomCard).toHaveAttribute("data-source-kind", "newsroom_article");
+  await expect(page.locator('.broadcast-alert[data-source-kind="radio_transcript"]')).toHaveCount(0);
+
+  await page.screenshot({
+    path: "test-output/signals-live-transcript.png",
+    fullPage: false,
+    animations: "disabled",
+  });
+
+  // 5. Selecting an untranscribed secondary feed shows honest AUDIO-ONLY FEED state & switches back cleanly
+  const secondaryTuneBtn = page
+    .locator(".pulse-scanner-card")
+    .filter({ hasNotText: "47003" })
+    .getByRole("button", { name: "Tune feed" })
+    .first();
+  await secondaryTuneBtn.click();
+  await expect(page.getByTestId("scanner-untranscribed-feed")).toBeVisible({ timeout: 10_000 });
+  await expect(page.getByTestId("scanner-status-pill")).toContainText("AUDIO-ONLY FEED");
+  await page.getByRole("button", { name: /Switch to Feed #47003 live transcript/ }).click();
+  await expect(page.locator(".scanner-segment-item").first()).toBeVisible({ timeout: 10_000 });
+  await page.locator(".pulse-scanner-section").screenshot({
+    path: "test-output/scanner-console-panel.png",
+    animations: "disabled",
+  });
+
+  // 6. Mobile responsiveness check (390x844, zero horizontal overflow)
+  const mobileCtx = await browser.newContext({
+    viewport: { width: 390, height: 844 },
+    isMobile: true,
+    ignoreHTTPSErrors: true,
+  });
+  await stubThirdPartyFeeds(mobileCtx);
+  const mobilePage = await mobileCtx.newPage();
+  mobilePage.on("pageerror", (err) => pageErrors.push(err.message));
+  await mobilePage.goto(`${LIVE_URL}/hub/signals/`, { waitUntil: "domcontentloaded" });
+  await expect(mobilePage.locator(".scanner-transcript-panel")).toBeVisible();
+  const hasOverflow = await mobilePage.evaluate(
+    () => document.documentElement.scrollWidth > window.innerWidth,
+  );
+  if (hasOverflow) {
+    throw new Error("Horizontal overflow detected on mobile /hub/signals/ scanner transcript view");
+  }
+  await mobilePage.screenshot({
+    path: "test-output/signals-mobile.png",
+    fullPage: false,
+    animations: "disabled",
+  });
+
+  // ─── PART 2: Unreachable / static-host verification (honest offline state, zero fake dispatches) ───
+  const offlineCtx = await browser.newContext({
+    viewport: { width: 1440, height: 900 },
+    ignoreHTTPSErrors: true,
+  });
+  await stubThirdPartyFeeds(offlineCtx);
+  const offlinePage = await offlineCtx.newPage();
+  offlinePage.on("pageerror", (err) => pageErrors.push(err.message));
+  await offlinePage.goto("http://127.0.0.1:4174/hub/signals/", { waitUntil: "domcontentloaded" });
+  const offlinePanel = offlinePage.locator(".scanner-transcript-panel");
+  await expect(offlinePanel.getByTestId("scanner-status-pill")).toContainText(
+    "SERVICE UNAVAILABLE",
+    { timeout: 10_000 },
+  );
+  await expect(offlinePanel).toHaveAttribute("data-scanner-live", "false");
+  await expect(offlinePanel.locator(".scanner-segment-item")).toHaveCount(0);
+  await expect(offlinePanel.getByTestId("scanner-empty-state")).toContainText(
+    "Live scanner transcription service is unavailable.",
+  );
+
+  if (pageErrors.length > 0) {
+    throw new Error(`Browser page errors encountered: ${pageErrors.join("; ")}`);
+  }
+
+  console.log(
+    "ALL LIVE SCANNER VERTICAL SLICE, PROVENANCE, MOBILE, AND OFFLINE HONESTY CHECKS PASSED",
+  );
+} finally {
+  staticOnlyServer.kill("SIGTERM");
+  await browser.close();
+}
diff --git a/tests/scanner-provenance.test.mjs b/tests/scanner-provenance.test.mjs
new file mode 100644
index 0000000..e70065c
--- /dev/null
+++ b/tests/scanner-provenance.test.mjs
@@ -0,0 +1,146 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  buildRSSAlert,
+  classifyPulseSourceKind,
+  formatAlertSourceBadge,
+  getVerifiedCheyenneWyomingBaseline,
+} from "../src/lib/pulse-ingestion.ts";
+import {
+  SCANNER_TRANSCRIPT_DISCLAIMER_LINES,
+  describeScannerOperationalState,
+  formatMountainClockRange,
+  formatTranscriptAge,
+  mergeTranscriptSegments,
+} from "../src/lib/scanner-client.ts";
+
+test("newsroom RSS items mentioning police, sheriff, fire, or crash NEVER become source='scanner'", () => {
+  const capCityFeed = {
+    name: "Cap City News",
+    url: "https://capcity.news/category/crime/feed/",
+    defaultCity: "Cheyenne",
+    defaultCounty: "Laramie County",
+    defaultFeedId: "47003",
+  };
+
+  const article = buildRSSAlert(
+    capCityFeed,
+    "Cheyenne Police arrest suspect after high-speed pursuit near I-80",
+    "<p>Cheyenne Police and Laramie County Sheriff deputies responded to a 911 dispatch.</p>",
+    "https://capcity.news/crime/2026/10/21/cheyenne-police-pursuit/",
+    "Wed, 21 Oct 2026 16:00:00 GMT",
+  );
+
+  assert.ok(article);
+  assert.equal(article.source, "rss-cap-city-news");
+  assert.notEqual(article.source, "scanner");
+  assert.equal(classifyPulseSourceKind(article), "newsroom_article");
+  assert.equal(formatAlertSourceBadge(article), "NEWSROOM · CAP CITY NEWS");
+  // Inferred related scanner feed stays strictly separate from verbatim article facts.
+  assert.equal(article.talkgroup, undefined);
+  assert.equal(article.agency, undefined);
+  assert.equal(article.related_feed_id, "47003");
+  assert.equal(article.metadata_origin, "inferred_related_feed");
+  assert.deepEqual(article.tags, ["Cap City News"]);
+});
+
+test("baseline Cheyenne & Wyoming items keep municipal, newsroom, agency, CAD, and radio sources strictly distinct", () => {
+  const baseline = getVerifiedCheyenneWyomingBaseline();
+  assert.ok(baseline.length >= 10);
+
+  // None of the newsroom articles or municipal press releases may masquerade as `source: "scanner"`.
+  const fakeScanners = baseline.filter((item) => item.source === "scanner");
+  assert.equal(fakeScanners.length, 0);
+
+  const cityRelease = baseline.find((item) =>
+    item.source_id.includes("Cheyenne-Fire-Rescue-Stops-Dumpster-Fire"),
+  );
+  assert.ok(cityRelease);
+  assert.equal(cityRelease.source, "cheyenne");
+  assert.equal(classifyPulseSourceKind(cityRelease), "municipal_release");
+  assert.equal(formatAlertSourceBadge(cityRelease), "CITY OF CHEYENNE");
+  assert.equal(cityRelease.related_feed_id, "46189");
+  assert.equal(cityRelease.metadata_origin, "inferred_related_feed");
+
+  const capCityStory = baseline.find((item) =>
+    item.source_id.includes("us-marshals-arrest-five-year-fugitive"),
+  );
+  assert.ok(capCityStory);
+  assert.equal(capCityStory.source, "rss-cap-city-news");
+  assert.equal(classifyPulseSourceKind(capCityStory), "newsroom_article");
+  assert.equal(formatAlertSourceBadge(capCityStory), "NEWSROOM · CAP CITY NEWS");
+
+  assert.equal(
+    formatAlertSourceBadge({ source: "scanner", tags: [] }),
+    "RADIO TRANSCRIPT",
+  );
+  assert.equal(
+    formatAlertSourceBadge({ source: "cad", tags: [] }),
+    "DISPATCH CAD RECORD",
+  );
+});
+
+test("scanner operational helper never fakes live status when stale, disconnected, or unreachable", () => {
+  const nowMs = Date.parse("2026-10-21T18:30:00Z");
+
+  const offline = describeScannerOperationalState("service_unreachable", null, null, nowMs);
+  assert.equal(offline.isTrulyLive, false);
+  assert.equal(offline.badgeLabel, "SERVICE UNAVAILABLE");
+
+  const staleHealth = {
+    status: "receiving_audio",
+    healthy: true,
+    stale: true,
+    checked_at_utc: "2026-10-21T18:30:00Z",
+    last_audio_received_at: "2026-10-21T18:28:00Z",
+    audio_age_seconds: 120,
+    stale_after_seconds: 35,
+    last_transcribed_audio_end_at: null,
+    last_published_at: null,
+    pending_backlog: 0,
+    estimated_processing_lag_ms: null,
+    last_capture_to_publish_ms: null,
+    current_error: null,
+  };
+  const staleView = describeScannerOperationalState(
+    "receiving_audio",
+    staleHealth,
+    nowMs,
+    nowMs,
+  );
+  assert.equal(staleView.isTrulyLive, false);
+  assert.match(staleView.badgeLabel, /STALE/);
+
+  // Even if health payload looked fresh at fetch time, if client polling stalled for 60s, never claim live!
+  const freshPayloadOldFetch = { ...staleHealth, stale: false, audio_age_seconds: 2 };
+  const clientStalled = describeScannerOperationalState(
+    "receiving_audio",
+    freshPayloadOldFetch,
+    nowMs - 60_000,
+    nowMs,
+  );
+  assert.equal(clientStalled.isTrulyLive, false);
+
+  // Verbatim disclaimer check
+  assert.deepEqual(SCANNER_TRANSCRIPT_DISCLAIMER_LINES, [
+    "Automatic radio transcription. May contain errors or omissions.",
+    "Not verified dispatch information and not for emergency response.",
+  ]);
+
+  // Mountain Time formatting check (2026-10-21T18:05:10Z -> 12:05:10 PM MDT)
+  const mtRange = formatMountainClockRange(
+    "2026-10-21T18:05:00Z",
+    "2026-10-21T18:05:10Z",
+  );
+  assert.match(mtRange, /12:05:00 PM/);
+  assert.match(mtRange, /12:05:10 PM/);
+  assert.match(mtRange, /MDT/);
+  assert.equal(formatTranscriptAge("2026-10-21T18:29:45Z", nowMs), "15s old");
+
+  // Idempotent cursor sorting (newest cursor first, deduplicated by segment_id)
+  const merged = mergeTranscriptSegments(
+    [{ segment_id: "a", cursor: 1 }, { segment_id: "b", cursor: 2 }],
+    [{ segment_id: "b", cursor: 2 }, { segment_id: "c", cursor: 3 }],
+  );
+  assert.deepEqual(merged.map((s) => s.segment_id), ["c", "b", "a"]);
+});
