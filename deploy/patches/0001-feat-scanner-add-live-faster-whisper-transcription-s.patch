+                data-segment-recency={isRecentLiveWindow ? "recent-live" : "earlier-recorded"}
+              >
+                <div className="scanner-segment-meta">
+                  <span
+                    className={`scanner-recency-badge ${
+                      isRecentLiveWindow ? "recent" : "historical"
