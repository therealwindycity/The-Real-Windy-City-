+            <strong>
+              {connectionState === "service_unreachable"
+                ? "Live scanner transcription service is unavailable."
+                : "No spoken radio segments recorded in the current retention window."}
+            </strong>
+            <p>
+              {connectionState === "service_unreachable"
+                ? "Connect a persistent backend host via NEXT_PUBLIC_SCANNER_API_BASE_URL or same-origin /api/scanner proxy. Newsroom articles and CAD logs below remain separate and are never shown as radio transcripts."
+                : "Silence, carrier hum, and unintelligible squelch bursts are suppressed rather than replaced with guessed text."}
+            </p>
+          </div>
+        </div>
+      )}
+    </section>
+  );
+}
