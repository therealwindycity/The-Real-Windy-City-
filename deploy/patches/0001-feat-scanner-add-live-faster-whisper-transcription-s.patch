index 0000000..0b935f0
--- /dev/null
+++ b/src/lib/scanner-client.ts
@@ -0,0 +1,328 @@
+/**
+ * Client-side types, Mountain Time formatters, and truthful status helpers for the
+ * Civic Cheyenne Live Scanner Transcription API.
+ *
+ * Security invariants:
+ * - Browser code NEVER holds upstream audio credentials or backend bearer tokens.
+ * - By default requests use the same-origin reverse-proxied path `/api/scanner`
+ *   (or `NEXT_PUBLIC_SCANNER_API_BASE_URL` pointing to a TLS reverse proxy such as Caddy).
+ * - Browser code NEVER calls `localhost` / `127.0.0.1` directly unless explicitly overridden
+ *   by test harness configuration.
+ */
+
+export type BackendScannerStatus =
+  | "connecting"
+  | "receiving_audio"
+  | "no_speech_detected"
+  | "transcription_pending"
+  | "publishing"
+  | "upstream_unavailable"
+  | "asr_failure"
+  | "storage_failure"
+  | "stopped";
+
+export type PanelConnectionState =
+  | BackendScannerStatus
+  | "loading"
+  | "feed_not_transcribed"
+  | "service_unreachable";
+
+export interface ScannerFeedMetadata {
+  feed_id: string;
+  feed_name: string;
+  source_type: string;
+  source_origin: string | null;
+  source_url_redacted: string | null;
+  source_authorized: boolean;
+  attribution: string;
+}
+
+export interface ScannerErrorInfo {
+  code: string;
+  message: string;
+  at_utc: string;
+}
+
+export interface ScannerGapRecord {
+  gap_id: string;
+  feed_id: string;
+  session_id: string | null;
+  gap_start_utc: string;
+  gap_end_utc: string;
+  duration_seconds: number;
+  reason: string;
+  recorded_at_utc: string;
+}
+
+export interface ScannerSegment {
+  cursor: number;
+  segment_id: string;
+  feed_id: string;
+  feed_name: string;
+  session_id: string;
+  sequence_no: number;
+  audio_start_utc: string;
+  audio_end_utc: string;
+  duration_seconds: number;
+  transcribed_at_utc: string;
+  published_at_utc: string | null;
+  capture_to_publish_ms: number | null;
+  asr_backend: string;
+  asr_model: string;
+  language: string;
+  text: string;
+  verification_status: string;
+  audio_sha256: string;
+  audio_bytes: number;
+  audio_retained: boolean;
+  private_audio_ref: string | null;
+  audio_purged_at_utc: string | null;
+  metrics: Record<string, number | string | boolean | null>;
+  inferred_tags: string[];
+}
+
+export interface ScannerHealthSummary {
+  status: BackendScannerStatus;
+  healthy: boolean;
+  stale: boolean;
+  checked_at_utc: string;
+  last_audio_received_at: string | null;
+  audio_age_seconds: number | null;
+  stale_after_seconds: number;
+  last_transcribed_audio_end_at: string | null;
+  last_published_at: string | null;
+  pending_backlog: number;
+  estimated_processing_lag_ms: number | null;
+  last_capture_to_publish_ms: number | null;
+  current_error: ScannerErrorInfo | null;
+}
+
+export interface ScannerSegmentsResponse {
+  feed: ScannerFeedMetadata;
+  health: ScannerHealthSummary;
+  recent_gaps: ScannerGapRecord[];
+  segments: ScannerSegment[];
+  next_cursor: number | null;
+  latest_cursor: number;
+  total_published: number;
+  has_more: boolean;
+  disclaimer: string;
+}
+
+/** Verbatim two-line safety & accuracy disclaimer required on every transcript display. */
+export const SCANNER_TRANSCRIPT_DISCLAIMER_LINES = [
+  "Automatic radio transcription. May contain errors or omissions.",
+  "Not verified dispatch information and not for emergency response.",
+] as const;
+
+export function getScannerApiBase(): string {
+  const configured = (process.env.NEXT_PUBLIC_SCANNER_API_BASE_URL ?? "").trim();
+  if (configured) return configured.replace(/\/+$/, "");
+  const basePath = (process.env.NEXT_PUBLIC_BASE_PATH ?? "").replace(/\/+$/, "");
+  return `${basePath}/api/scanner`;
+}
+
+export function formatMountainTimestamp(utcIso: string | null | undefined): string {
+  if (!utcIso) return "—";
+  const parsed = new Date(utcIso);
+  if (!Number.isFinite(parsed.getTime())) return "Invalid timestamp";
+  return new Intl.DateTimeFormat("en-US", {
+    timeZone: "America/Denver",
+    month: "short",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+    second: "2-digit",
+    hour12: true,
+    timeZoneName: "short",
+  }).format(parsed);
+}
+
+export function formatMountainClockRange(startUtc: string, endUtc: string): string {
+  const start = new Date(startUtc);
+  const end = new Date(endUtc);
+  if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime())) {
+    return "Time unavailable";
+  }
+  const timeFmt = new Intl.DateTimeFormat("en-US", {
+    timeZone: "America/Denver",
+    hour: "numeric",
+    minute: "2-digit",
+    second: "2-digit",
+    hour12: true,
+  });
+  const zoneFmt = new Intl.DateTimeFormat("en-US", {
+    timeZone: "America/Denver",
+    month: "short",
+    day: "numeric",
+    timeZoneName: "short",
+  });
+  return `${timeFmt.format(start)} – ${timeFmt.format(end)} (${zoneFmt.format(end)})`;
+}
+
+export function formatTranscriptAge(utcIso: string | null | undefined, nowMs: number): string {
+  if (!utcIso) return "no audio yet";
+  const ts = new Date(utcIso).getTime();
+  if (!Number.isFinite(ts)) return "unknown age";
+  const sec = Math.max(0, Math.floor((nowMs - ts) / 1000));
+  if (sec < 60) return `${sec}s old`;
+  const min = Math.floor(sec / 60);
+  const remSec = sec % 60;
+  if (min < 60) return remSec > 0 ? `${min}m ${remSec}s old` : `${min}m old`;
+  const hrs = Math.floor(min / 60);
+  const remMin = min % 60;
+  if (hrs < 24) return `${hrs}h ${remMin}m old`;
+  return `${Math.floor(hrs / 24)}d old`;
+}
+
+export function formatLagDuration(lagMs: number | null | undefined): string {
+  if (lagMs === null || lagMs === undefined || !Number.isFinite(lagMs)) return "—";
+  if (lagMs < 1000) return `${Math.round(lagMs)} ms`;
+  return `${(lagMs / 1000).toFixed(2)} s`;
+}
+
+/**
+ * Compute whether the panel may truthfully claim live status.
+ * NEVER claims live from a timer alone: requires a recent backend response where
+ * `health.healthy === true`, `!health.stale`, and client fetch age <= stale threshold.
+ */
+export function describeScannerOperationalState(
+  state: PanelConnectionState,
+  health: ScannerHealthSummary | null,
+  lastClientFetchMs: number | null,
+  nowMs: number,
+): {
+  badgeLabel: string;
+  tone: "live" | "pending" | "warning" | "offline";
+  isTrulyLive: boolean;
+  detail: string;
+} {
+  if (state === "loading") {
+    return {
+      badgeLabel: "CONNECTING TO SERVICE",
+      tone: "pending",
+      isTrulyLive: false,
+      detail: "Checking live scanner transcription worker status…",
+    };
+  }
+  if (state === "feed_not_transcribed") {
+    return {
+      badgeLabel: "AUDIO-ONLY FEED",
+      tone: "warning",
+      isTrulyLive: false,
+      detail:
+        "Live machine transcription is currently provisioned on Feed #47003 (Laramie County Law Enforcement). Use the audio player above to listen directly to this feed.",
+    };
+  }
+  if (state === "service_unreachable" || !health) {
+    return {
+      badgeLabel: "SERVICE UNAVAILABLE",
+      tone: "offline",
+      isTrulyLive: false,
+      detail:
+        "The live scanner transcription service is unreachable or not deployed for this host. Audio links above remain available; no placeholder transcripts or news/CAD items are substituted.",
+    };
+  }
+
+  const clientPollStale =
+    lastClientFetchMs !== null &&
+    nowMs - lastClientFetchMs > Math.max(15_000, health.stale_after_seconds * 1000);
+
+  if (clientPollStale || health.stale) {
+    return {
+      badgeLabel: "STALE · NO RECENT AUDIO",
+      tone: "warning",
+      isTrulyLive: false,
+      detail: health.current_error?.message
+        ? `Audio stream stale (${health.status}): ${health.current_error.message}`
+        : `No fresh audio frames verified within the ${health.stale_after_seconds}s freshness window.`,
+    };
+  }
+
+  switch (health.status) {
+    case "receiving_audio":
+      return {
+        badgeLabel: "LIVE · RECEIVING AUDIO",
+        tone: "live",
+        isTrulyLive: health.healthy,
+        detail: "Authorized radio stream connected and monitored continuously.",
+      };
+    case "no_speech_detected":
+      return {
+        badgeLabel: "LIVE · QUIET CHANNEL (NO SPEECH)",
+        tone: "live",
+        isTrulyLive: health.healthy,
+        detail: "Stream audio is live; squelch/silence intervals are filtered without inventing text.",
+      };
+    case "transcription_pending":
+      return {
+        badgeLabel: "LIVE · TRANSCRIBING AUDIO",
+        tone: "live",
+        isTrulyLive: health.healthy,
+        detail: "Running faster-whisper speech recognition on captured radio audio.",
+      };
+    case "publishing":
+      return {
+        badgeLabel: "LIVE · PUBLISHING SEGMENT",
+        tone: "live",
+        isTrulyLive: health.healthy,
+        detail: "Persisting verified segment timestamp and text to durable SQLite storage.",
+      };
+    case "connecting":
+      return {
+        badgeLabel: "CONNECTING TO STREAM",
+        tone: "pending",
+        isTrulyLive: false,
+        detail: "Worker started and opening upstream radio stream…",
+      };
+    case "upstream_unavailable":
+      return {
+        badgeLabel: "UPSTREAM DISCONNECTED",
+        tone: "offline",
+        isTrulyLive: false,
+        detail:
+          health.current_error?.message ||
+          "Upstream scanner audio source disconnected; automatic bounded reconnect is active.",
+      };
+    case "asr_failure":
+      return {
+        badgeLabel: "ASR FAILURE",
+        tone: "offline",
+        isTrulyLive: false,
+        detail:
+          health.current_error?.message ||
+          "Speech-to-text engine reported an error; affected audio interval recorded as a coverage gap.",
+      };
+    case "storage_failure":
+      return {
+        badgeLabel: "STORAGE FAILURE",
+        tone: "offline",
+        isTrulyLive: false,
+        detail:
+          health.current_error?.message ||
+          "Durable transcript store is degraded; segments are never published without persistence.",
+      };
+    case "stopped":
+    default:
+      return {
+        badgeLabel: "WORKER STOPPED",
+        tone: "offline",
+        isTrulyLive: false,
+        detail: "Transcription worker is stopped.",
+      };
+  }
+}
+
+/** Merge incoming segments idempotently by `segment_id` sorted newest capture end first for UI display. */
+export function mergeTranscriptSegments(
+  existing: ScannerSegment[],
+  incoming: ScannerSegment[],
+  maxItems = 80,
+): ScannerSegment[] {
+  const byId = new Map<string, ScannerSegment>();
+  for (const seg of existing) byId.set(seg.segment_id, seg);
+  for (const seg of incoming) byId.set(seg.segment_id, seg);
+  return Array.from(byId.values())
+    .sort((a, b) => b.cursor - a.cursor)
+    .slice(0, maxItems);
+}
