+"use client";
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { AlertTriangle, Clock, Radio, RefreshCw, ShieldAlert } from "lucide-react";
+import type { WyomingScannerFeed } from "@/lib/wyoming-cities";
+import {
+  SCANNER_TRANSCRIPT_DISCLAIMER_LINES,
+  describeScannerOperationalState,
+  formatLagDuration,
+  formatMountainClockRange,
+  formatMountainTimestamp,
+  formatTranscriptAge,
+  getScannerApiBase,
+  mergeTranscriptSegments,
+  type PanelConnectionState,
+  type ScannerFeedMetadata,
+  type ScannerGapRecord,
+  type ScannerHealthSummary,
+  type ScannerSegment,
+  type ScannerSegmentsResponse,
+} from "@/lib/scanner-client";
+
+interface LiveScannerTranscriptPanelProps {
+  activeFeed: WyomingScannerFeed;
+  onSelectFeed?: (feedId: string) => void;
+}
+
+const LIVE_RECENCY_THRESHOLD_MS = 120_000;
+
+export function LiveScannerTranscriptPanel({
+  activeFeed,
+  onSelectFeed,
+}: LiveScannerTranscriptPanelProps) {
+  const [connectionState, setConnectionState] = useState<PanelConnectionState>("loading");
+  const [feedMeta, setFeedMeta] = useState<ScannerFeedMetadata | null>(null);
+  const [health, setHealth] = useState<ScannerHealthSummary | null>(null);
+  const [segments, setSegments] = useState<ScannerSegment[]>([]);
+  const [gaps, setGaps] = useState<ScannerGapRecord[]>([]);
+  const [lastClientFetchMs, setLastClientFetchMs] = useState<number | null>(null);
+  const [nowMs, setNowMs] = useState<number>(() => Date.now());
+  const [manualRefreshing, setManualRefreshing] = useState(false);
+
+  const latestCursorRef = useRef<number>(0);
+
+  // Advance relative transcript ages & staleness checks without ever faking backend live status.
+  useEffect(() => {
+    const timer = window.setInterval(() => setNowMs(Date.now()), 2000);
+    return () => window.clearInterval(timer);
+  }, []);
+
+  const fetchFeedSnapshot = useCallback(
+    async (feedId: string, incrementalOnly: boolean) => {
+      const apiBase = getScannerApiBase();
+      const cursorParam =
+        incrementalOnly && latestCursorRef.current > 0
+          ? `&after_cursor=${latestCursorRef.current}`
+          : "";
+      const url = `${apiBase}/feeds/${encodeURIComponent(feedId)}/segments?limit=50${cursorParam}`;
+
+      try {
+        const resp = await fetch(url, {
+          cache: "no-store",
+          headers: { Accept: "application/json" },
+          signal: AbortSignal.timeout(8000),
+        });
+
+        if (resp.status === 404) {
+          // Distinguish an untranscribed secondary feed (e.g., #46189) from total static-host absence.
+          const healthCheck = await fetch(`${apiBase}/health`, {
+            cache: "no-store",
+            headers: { Accept: "application/json" },
+            signal: AbortSignal.timeout(5000),
+          }).catch(() => null);
+
+          if (
+            healthCheck &&
+            healthCheck.ok &&
+            (healthCheck.headers.get("content-type") || "").includes("application/json")
+          ) {
+            setConnectionState("feed_not_transcribed");
+            setHealth(null);
+            setSegments([]);
+            setGaps([]);
+            return;
+          }
+          setConnectionState("service_unreachable");
+          setHealth(null);
+          return;
+        }
+
+        if (!resp.ok) {
+          setConnectionState("service_unreachable");
+          setHealth(null);
+          return;
+        }
+
+        const contentType = resp.headers.get("content-type") || "";
+        if (!contentType.includes("application/json")) {
+          setConnectionState("service_unreachable");
+          setHealth(null);
+          return;
+        }
+
+        const data = (await resp.json()) as ScannerSegmentsResponse;
+        setFeedMeta(data.feed);
+        setHealth(data.health);
+        setGaps(data.recent_gaps || []);
+        setConnectionState(data.health.status);
+        const fetchedAt = Date.now();
+        setLastClientFetchMs(fetchedAt);
+        setNowMs(fetchedAt);
+
+        if (data.latest_cursor > latestCursorRef.current) {
+          latestCursorRef.current = data.latest_cursor;
+        }
+        setSegments((prev) =>
+          incrementalOnly
+            ? mergeTranscriptSegments(prev, data.segments)
+            : mergeTranscriptSegments([], data.segments),
+        );
+      } catch {
+        setConnectionState("service_unreachable");
+      }
+    },
+    [],
+  );
+
+  useEffect(() => {
+    latestCursorRef.current = 0;
+
+    let cancelled = false;
+    void fetchFeedSnapshot(activeFeed.id, false);
+
+    // Poll incrementally every 4 seconds so UI always stays synchronized even if proxies buffer SSE.
+    const pollInterval = window.setInterval(() => {
+      if (!cancelled) {
+        void fetchFeedSnapshot(activeFeed.id, true);
+      }
+    }, 4000);
+
+    // Also attach SSE stream when EventSource is available for sub-second push updates.
+    let eventSource: EventSource | null = null;
+    if (typeof EventSource !== "undefined") {
+      try {
+        const apiBase = getScannerApiBase();
+        eventSource = new EventSource(
+          `${apiBase}/feeds/${encodeURIComponent(activeFeed.id)}/stream`,
+        );
+        eventSource.addEventListener("segment", (ev: MessageEvent<string>) => {
+          try {
+            const seg = JSON.parse(ev.data) as ScannerSegment;
+            if (typeof seg.cursor === "number" && seg.cursor > latestCursorRef.current) {
+              latestCursorRef.current = seg.cursor;
+            }
+            setSegments((prev) => mergeTranscriptSegments(prev, [seg]));
+            setLastClientFetchMs(Date.now());
+          } catch {
+            // Ignore malformed frame; next cursor poll reconciles cleanly.
+          }
+        });
+        eventSource.addEventListener("status", (ev: MessageEvent<string>) => {
+          try {
+            const payload = JSON.parse(ev.data) as Partial<ScannerHealthSummary>;
+            if (payload.status) {
+              setConnectionState(payload.status);
+              setLastClientFetchMs(Date.now());
+            }
+          } catch {
+            // Ignore malformed status frame.
+          }
+        });
+        eventSource.addEventListener("gap", (ev: MessageEvent<string>) => {
+          try {
+            const gap = JSON.parse(ev.data) as ScannerGapRecord;
+            setGaps((prev) => {
+              const map = new Map(prev.map((item) => [item.gap_id, item]));
+              map.set(gap.gap_id, gap);
+              return Array.from(map.values()).slice(0, 8);
+            });
+          } catch {
+            // Ignore malformed gap frame.
+          }
+        });
+      } catch {
+        eventSource = null;
+      }
+    }
+
+    return () => {
+      cancelled = true;
+      window.clearInterval(pollInterval);
+      if (eventSource) {
+        eventSource.close();
+      }
+    };
+  }, [activeFeed.id, fetchFeedSnapshot]);
+
+  const opState = useMemo(
+    () => describeScannerOperationalState(connectionState, health, lastClientFetchMs, nowMs),
+    [connectionState, health, lastClientFetchMs, nowMs],
+  );
+
+  const handleManualRefresh = async () => {
+    setManualRefreshing(true);
+    await fetchFeedSnapshot(activeFeed.id, false);
+    setManualRefreshing(false);
+  };
+
+  const newestSegment = segments[0] ?? null;
+
+  return (
+    <section
+      className="scanner-transcript-panel"
+      aria-labelledby="scanner-transcript-heading"
+      data-scanner-status={connectionState}
+      data-scanner-live={opState.isTrulyLive ? "true" : "false"}
+    >
+      {/* Mandatory verbatim safety & machine-transcription disclaimer */}
+      <div className="scanner-transcript-disclaimer" role="note" aria-label="Scanner transcription disclaimer">
+        <ShieldAlert size={15} aria-hidden="true" />
+        <div>
+          <p>{SCANNER_TRANSCRIPT_DISCLAIMER_LINES[0]}</p>
+          <p>{SCANNER_TRANSCRIPT_DISCLAIMER_LINES[1]}</p>
+        </div>
+      </div>
+
+      <div className="scanner-transcript-header">
+        <div>
+          <div className="scanner-transcript-kicker-row">
+            <span
+              className={`scanner-status-pill scanner-status-pill--${opState.tone}`}
+              data-testid="scanner-status-pill"
+            >
+              <span className="scanner-status-dot" />
+              {opState.badgeLabel}
+            </span>
+            <span className="scanner-attribution-tag">
