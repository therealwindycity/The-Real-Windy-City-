diff --git a/scripts/run-live-preview-stack.mjs b/scripts/run-live-preview-stack.mjs
new file mode 100644
index 0000000..d7ba811
--- /dev/null
+++ b/scripts/run-live-preview-stack.mjs
@@ -0,0 +1,150 @@
+#!/usr/bin/env node
+/**
+ * Self-contained live preview stack launcher:
+ * 1. Streams real redistributable speech WAVs interleaved with real digital silence over HTTP
+ *    on 127.0.0.1:8788 (simulating an authorized narrowband radio relay with quiet squelch periods).
+ * 2. Runs the real Python `scanner-transcriber serve` service on 127.0.0.1:8787
+ *    (ffmpeg -> faster-whisper CTranslate2 INT8 -> SQLite WAL -> authenticated FastAPI + SSE).
+ * 3. Serves the built Next.js static export (`out/`) on 0.0.0.0:4173 via `scripts/serve.mjs`
+ *    with server-side `/api/scanner` Bearer proxy injection.
+ */
+import crypto from "node:crypto";
+import fs from "node:fs";
+import http from "node:http";
+import path from "node:path";
+import { spawn } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.resolve(__dirname, "..");
+const port = Number(process.env.PORT || 4173);
+const scannerPort = Number(process.env.SCANNER_PORT || 8787);
+const relayPort = Number(process.env.RELAY_PORT || 8788);
+const apiToken = process.env.SCANNER_API_TOKEN || crypto.randomBytes(24).toString("hex");
+const dataDir = process.env.SCANNER_DATA_DIR || "/tmp/civic-scanner-preview-data";
+
+const fixturesDir = path.resolve(
+  repoRoot,
+  "services/scanner_transcriber/tests/fixtures",
+);
+const fallbackFixturesDir =
+  "/home/user/The-Real-Windy-City-/services/scanner_transcriber/tests/fixtures";
+const resolvedFixtures = fs.existsSync(path.join(fixturesDir, "jfk_16k.wav"))
+  ? fixturesDir
+  : fallbackFixturesDir;
+
+function extractRawPcm16FromWav(wavFile) {
+  const buf = fs.readFileSync(wavFile);
+  // Locate the "data" chunk cleanly rather than assuming a fixed 44-byte header.
+  let offset = 12;
+  while (offset + 8 <= buf.length) {
+    const id = buf.subarray(offset, offset + 4).toString("ascii");
+    const size = buf.readUInt32LE(offset + 4);
+    if (id === "data") {
+      return buf.subarray(offset + 8, Math.min(buf.length, offset + 8 + size));
+    }
+    offset += 8 + size + (size % 2);
+  }
+  return buf.subarray(44);
+}
+
+const jfkPcm = extractRawPcm16FromWav(path.join(resolvedFixtures, "jfk_16k.wav"));
+const everTriedPcm = extractRawPcm16FromWav(path.join(resolvedFixtures, "ever_tried_16k.wav"));
+const silence4s = Buffer.alloc(16_000 * 2 * 4, 0); // 4.0s of 16kHz 16-bit mono silence
+const programCycle = Buffer.concat([jfkPcm, silence4s, everTriedPcm, silence4s]);
+
+function buildInfiniteWavHeader() {
+  const hdr = Buffer.alloc(44);
+  hdr.write("RIFF", 0);
+  hdr.writeUInt32LE(0x7fffffff, 4);
+  hdr.write("WAVEfmt ", 8);
+  hdr.writeUInt32LE(16, 16);
+  hdr.writeUInt16LE(1, 20); // PCM
+  hdr.writeUInt16LE(1, 22); // mono
+  hdr.writeUInt32LE(16000, 24); // 16kHz
+  hdr.writeUInt32LE(32000, 28); // byte rate
+  hdr.writeUInt16LE(2, 32); // block align
+  hdr.writeUInt16LE(16, 34); // bits per sample
+  hdr.write("data", 36);
+  hdr.writeUInt32LE(0x7fffffff - 36, 40);
+  return hdr;
+}
+
+const relayServer = http.createServer((req, res) => {
+  res.writeHead(200, {
+    "Content-Type": "audio/wav",
+    "Cache-Control": "no-store",
+  });
+  res.write(buildInfiniteWavHeader());
+
+  let cursor = 0;
+  const frameBytes = 8000; // 0.25s of 16kHz mono PCM every 250ms (exact 1.0x real-time radio pace)
+  const timer = setInterval(() => {
+    if (res.destroyed || !res.writable) {
+      clearInterval(timer);
+      return;
+    }
+    const end = Math.min(programCycle.length, cursor + frameBytes);
+    const slice = programCycle.subarray(cursor, end);
+    res.write(slice);
+    cursor = end >= programCycle.length ? 0 : end;
+  }, 250);
+
+  req.on("close", () => clearInterval(timer));
+});
+
+relayServer.listen(relayPort, "127.0.0.1", () => {
+  console.log(`[relay] Streaming 1.0x 16kHz PCM fixture loop on http://127.0.0.1:${relayPort}/47003.wav`);
+
+  const scannerBin =
+    process.env.SCANNER_BIN || "/home/user/.scanner-venv/bin/scanner-transcriber";
+
+  const backend = spawn(scannerBin, ["serve"], {
+    stdio: "inherit",
+    env: {
+      ...process.env,
+      SCANNER_ENV: "production",
+      SCANNER_DATA_DIR: dataDir,
+      SCANNER_FEED_ID: "47003",
+      SCANNER_FEED_NAME: "Laramie County Law Enforcement",
+      SCANNER_DIRECT_AUDIO_URL: `http://127.0.0.1:${relayPort}/47003.wav`,
+      SCANNER_SOURCE_AUTHORIZED: "true",
+      SCANNER_SOURCE_ATTRIBUTION:
+        "Broadcastify Feed #47003 · Laramie County Law Enforcement (local authorized stream relay)",
+      SCANNER_ALLOWED_HOSTS: "127.0.0.1,broadcastify.cdnstream1.com",
+      SCANNER_CHUNK_SECONDS: "6.0",
+      SCANNER_STALE_AFTER_SECONDS: "35.0",
+      SCANNER_ASR_BACKEND: "faster-whisper",
+      SCANNER_ASR_MODEL: "tiny.en",
+      SCANNER_REQUIRE_AUTH: "true",
+      SCANNER_API_TOKEN: apiToken,
+      SCANNER_BIND_HOST: "127.0.0.1",
+      SCANNER_BIND_PORT: String(scannerPort),
+    },
+  });
+
+  const web = spawn(process.execPath, [path.join(__dirname, "serve.mjs"), "out"], {
+    cwd: repoRoot,
+    stdio: "inherit",
+    env: {
+      ...process.env,
+      HOST: "0.0.0.0",
+      PORT: String(port),
+      SCANNER_UPSTREAM_URL: `http://127.0.0.1:${scannerPort}`,
+      SCANNER_API_TOKEN: apiToken,
+    },
+  });
+
+  const shutdown = () => {
+    web.kill("SIGTERM");
+    backend.kill("SIGTERM");
+    relayServer.close();
+  };
+
+  process.on("SIGINT", shutdown);
+  process.on("SIGTERM", shutdown);
+  backend.on("exit", (code) => {
+    if (code && code !== 0) console.error(`[scanner] exited with code ${code}`);
+  });
+  web.on("exit", (code) => process.exit(code ?? 0));
+});
diff --git a/scripts/serve.mjs b/scripts/serve.mjs
index 11514df..b62d677 100644
