+                  >
+                    {isRecentLiveWindow ? "LIVE WINDOW" : "EARLIER RECORDED"}
+                  </span>
+                  <time dateTime={seg.audio_start_utc} className="scanner-segment-time">
+                    <Clock size={11} aria-hidden="true" />
