# Civic Cheyenne Live Scanner Transcription Service — Environment Template
# Copy to /etc/civic-scanner/scanner.env (chmod 0600, owned by root:civic-scanner).
# NEVER commit real credentials, tokens, or session cookies to Git.

SCANNER_ENV=production
SCANNER_DATA_DIR=/var/lib/civic-scanner
SCANNER_WORKER_REVISION=main

# Single-feed vertical slice configuration (Broadcastify Feed #47003)
SCANNER_FEED_ID=47003
SCANNER_FEED_NAME=Laramie County Law Enforcement

# Configure EITHER a verified direct stream URL OR a page URL (never both).
# Do NOT enable continuous capture without verifying current feed terms and authorization.
SCANNER_DIRECT_AUDIO_URL=
SCANNER_PAGE_URL=
SCANNER_SOURCE_AUTHORIZED=false
SCANNER_SOURCE_ATTRIBUTION="Broadcastify Feed #47003 · Laramie County Law Enforcement (authorized feed relay)"

# Server-only upstream stream credentials (kept strictly off frontend JS & redacted in logs)
SCANNER_SOURCE_AUTH_HEADER=
SCANNER_SOURCE_COOKIE_FILE=
SCANNER_SOURCE_USER_AGENT="CivicCheyenneScannerTranscriber/0.1"

# Strict outbound host allowlist (comma-separated; prevents SSRF)
SCANNER_ALLOWED_HOSTS=broadcastify.cdnstream1.com,audio.broadcastify.com,www.broadcastify.com

# Audio chunking, timeout, staleness, and bounded reconnect backoff
SCANNER_CHUNK_SECONDS=10.0
SCANNER_MIN_FLUSH_SECONDS=0.6
SCANNER_READ_TIMEOUT_SECONDS=12.0
SCANNER_STALE_AFTER_SECONDS=35.0
SCANNER_RECONNECT_INITIAL_SECONDS=1.0
SCANNER_RECONNECT_MAX_SECONDS=60.0
SCANNER_RECONNECT_MULTIPLIER=2.0
SCANNER_MAX_PENDING_CHUNKS=32

# Real faster-whisper neural ASR settings (stub mode is strictly rejected in production)
SCANNER_ASR_BACKEND=faster-whisper
SCANNER_ASR_MODEL=tiny.en
SCANNER_ASR_DEVICE=cpu
SCANNER_ASR_COMPUTE_TYPE=int8
SCANNER_ASR_CPU_THREADS=2
SCANNER_ASR_BEAM_SIZE=1
SCANNER_ASR_LANGUAGE=en
SCANNER_SILENCE_RMS_DBFS=-52.0
SCANNER_MIN_SPEECH_FRAME_RATIO=0.03
SCANNER_MAX_NO_SPEECH_PROB=0.85

# Independent retention windows (seconds)
# Raw audio stays private (0700 dir / 0600 files) and is never served publicly.
SCANNER_RETAIN_PRIVATE_AUDIO=true
SCANNER_AUDIO_RETENTION_SECONDS=86400
SCANNER_TRANSCRIPT_RETENTION_SECONDS=604800
SCANNER_RETENTION_SWEEP_SECONDS=60

# HTTP API binding, bearer token authentication, and CORS allowlist
SCANNER_BIND_HOST=127.0.0.1
SCANNER_BIND_PORT=8787
SCANNER_REQUIRE_AUTH=true
# Generate with: openssl rand -hex 32
SCANNER_API_TOKEN=
SCANNER_CORS_ORIGINS=https://therealwindycity.github.io
